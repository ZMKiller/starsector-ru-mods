{
	"id":"ls_jet_shoota",
	"specClass":"missile",	
	"missileType":"MISSILE",
	"onFireEffect":"com.fs.starfarer.api.impl.combat.dem.DEMEffect",
	"behaviorSpec":{"behavior":"CUSTOM",
		"minDelayBeforeTriggering":0.25,
		"triggerDistance":[100,450],
		"preferredMinFireDistance":[200,350],
		"turnRateBoost":50,
		"targetingTime":0.25,
		"firingTime":12,
		"targetingLaserId":"targetinglaser1",
		"targetingLaserFireOffset":[4, 0],
		"payloadWeaponId":"ls_jet_shoota_payload",
		"targetingLaserRange":0,
		"targetingLaserArc":15,
		"bombPumped":false,
		"snapFacingToTargetIfCloseEnough":true,
		"fadeOutEngineWhenFiring":false;
		"randomStrafe":true;
		"destroyMissleWhenDoneFiring":true,
		"destroyedExplosionColor":[225,255,205,200],
	},
	"sprite":"graphics/weapons/ls_jet_shoota.png",
	"size":[14,31],	
	"center":[7,15.5],
	"collisionRadius":40,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[100,200,255,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":90, # purely visual	
	"engineSpec":{"turnAcc":200,
				  "turnRate":200,
				  "acc":200,
				  "dec":200},
	"engineSlots":[{"id":"ES1",
					"loc":[-16, 0],
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[255,145,75,255],
						"contrailDuration":.5,
						"contrailWidthMult":2,
						"contrailWidthAddedFractionAtEnd":2,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":0f, # how far away from engine it starts
						"contrailColor":[75,75,75,150],
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":6.0,
				    "length":28.0,
				    "angle":180.0}]
				    
}