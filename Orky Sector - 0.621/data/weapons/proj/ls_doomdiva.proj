{
	"id":"ls_doomdiva",
	"specClass":"missile",
	"missileType":"MISSILE",
    "onHitEffect":"data.weapons.ls_doomdiva_effect",
	#"missileType":"MISSILE_TWO_STAGE_SECOND_UNGUIDED",
	"sprite":"graphics/weapons/ls_doomdiva.png",
	"size":[14,24],	
	"center":[7,12],
	"collisionRadius":16,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[225,225,225,200],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":40, # purely visual
	"explosionSpec":{"duration":0.1f, # not visual
					 "radius":40,
					 "coreRadius":20, # full damage within core radius
					 "collisionClass":HITS_SHIPS_AND_ASTEROIDS,
					 "collisionClassByFighter":HITS_SHIPS_AND_ASTEROIDS,
					 "particleSizeMin":6.0,
					 "particleSizeRange":3.0,
					 "particleDuration":1,
					 "particleCount":60,
					 "particleColor":[225,225,225,200]},
	"armingTime":0.5,
	"engineSpec":{"turnAcc":400,
				  "turnRate":50,
				  "acc":1200,
				  "dec":200},
	"engineSlots":[{"id":"ES1",
					"loc":[-12, 0],
				    #"style":"ROCKET_LOW_TECH",
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[225,225,225,200],
						"contrailDuration":3,
						"contrailWidthMult":4,
						"contrailWidthAddedFractionAtEnd":-1,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":8, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":0f, # how far away from engine it starts
						"contrailColor":[75,75,75,150],
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":6.0,
				    "length":60.0,
				    "angle":180.0}]
}
