{
	"id":"ls_torpedo_bm",
	"specClass":"missile",
	"missileType":"MISSILE",
	"sprite":"graphics/weapons/Projectiles/ls_torpedo_bm.png",
	"onFireEffect":"data.weapons.ls_torpedo_OnFireEffect",
	"size":[12,24],	
	"center":[6,12],
	"collisionRadius":16,
	"collisionClass":"MISSILE_FF",
	"explosionColor":[255,240,50,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":230, # purely visual
	"explosionSpec":{"duration":0.1f, # not visual
					 "radius":180,
					 "coreRadius":100, # full damage within core radius
					 "collisionClass":HITS_SHIPS_AND_ASTEROIDS,
					 "collisionClassByFighter":HITS_SHIPS_AND_ASTEROIDS,
					 "particleSizeMin":6.0,
					 "particleSizeRange":5.0,
					 "particleDuration":1.5,
					 "particleCount":180,
					 "particleColor":[255,255,100,255]},
	"flameoutTime":3, # total time from flameout to full fadeout
	"armingTime":.5,
	"noEngineGlowTime":0.5, # time spent without the engine glow being rendered
	"fadeTime":0.5, # fadeout duration					 
	"engineSpec":{"turnAcc":30,
				  "turnRate":5,
				  "acc":500,
				  "dec":200},
	"engineSlots":[{"id":"ES1",
					"loc":[-12, 0],
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[255,180,70,255],
						"glowSizeMult":3,
						"contrailDuration":4,
						"contrailWidthMult":2,
						"contrailWidthAddedFractionAtEnd":3,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":.5, # how far away from engine it starts
						"contrailColor":[225,180,150,75],
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":10.0,
				    "length":32.0,
				    "angle":180.0}]
}