{
	#"name":"Boreale & Diomedes – Bald Brathas",
	"name":"Apollo Diomedes",
	"personalities":["aggressive", "reckless"],
	"gender":["m"],
	"chance":1,
	"talkativeness":1,
	"categoryTags":["dawnofwar", "game", "othermedia"],
	
	"lines":{
		"start":[
			#{"text":"Мы сражаемся за нашу честь! Мы сражаемся во имя Императора!"},
			{"text":"Соберитесь с силами и будьте готовы!"},
			{"text":"Все либо склонятся, либо падут перед нами."},
			{"text":"К славе и победе!"},
		],
		"start_boss":[
			{"text":"Я оставлю от него руины."},
			{"text":"Я сразил многих врагов пострашнее!"},
			{"text":"Даже эта тварь должна меня опасаться!"},
		],
		"retreat":[
			{"text":"Отступим сейчас ради победы потом!"},
			{"text":"Нам нельзя здесь оставаться!"},
		],
		"out_of_missiles":[
		],
		"engaged":[
			{"text":"Ни один враг не увидит моей пощады!"},
			{"text":"Моя сила истинна."},
			{"text":"Бой уже здесь!"},
			{"text":"Думаешь, ты мне ровня?"},
		],
		"need_help":[
			{"text":"Я под атакой!"},
			{"text":"Спокойно... спокойно..."},
			{"text":"Демоны насели на меня!"},
			{"text":"Меня окружил этот ужас!"},
		],
		"pursuing":[
			{"text":"Ты дрожишь, потому что слаб!"},
			{"text":"Посмотрим, на что ты теперь способен!"},
			{"text":"Ничто не должно встать у нас на пути!"},
			{"text":"Они совсем не готовы ко мне!"},
		],
		"running":[
			{"text":"Выхожу из-под удара."},
		],
		"hull_90":[
			{"text":"Я выдержу это."},
			{"text":"Это всего лишь легкая рана!"},
			{"text":"Это пустяк!"},
		],
		"hull_50":[
			{"text":"Брат, я подбит!"},
			{"text":"Держись, брат!"},
			{"text":"Я не паду так легко."},
		],
		"hull_30":[
			#{"text":"Если мы умрем сегодня, то умрем во славе!"},
			{"text":"Жить или умереть - все равно это будет слава!"},
			{"text":"Жалкие твари!"},
		],
		"overload":[
			{"text":"Брат, меня здесь зажали!"},
			{"text":"Они нас прижали!"},
		],
		"death":[
			{"text":"Вот... моя... слава."},
			{"text":"Я умираю... как и клялся."},
			{"text":"Мы подвели... Императора!"},
		],
		"victory":[
			#{"text":"Мы - ярость Императора!"},
			{"text":"Сила и честь! Слава и победа!"},
			{"text":"Этот оказался недостоин."},
			{"text":"Куда лучше тех, кто пытался до тебя!"},
		],
		"victory_boss":[
			
		]
	}
}
