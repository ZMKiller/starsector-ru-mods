	"lines":{
		"start":[
			{"text":"Нужно сохранять спокойствие! По одному..."},
			{"text":"Сила в числе, Восставший."},
			{"text":"Первый удар будет моим!"},
		],
		"start_boss":[
			{"text":"Не позволяй страху сдерживать тебя!"}, 
			{"text":"Готовься! Враг очень силен!"}, 
			{"text":"Что это за чудовище?!"}, 
		],		
		"retreat":[
			{"text":"Хорошо... если так нужно."},
			{"text":"Не эта пешка, не сегодня..."},
		],
		"out_of_missiles":[
			{"text":"Пока еще рано признавать поражение."},
			{"text":"Мы только начали, Мастер!"},
		],
		"engaged":[
			{"text":"Сразись со мной! Сразись, если посмеешь!"},
			{"text":"Держись крепко и отбрось это зло!"},
			{"text":"Не дай им окружить тебя!"},
		],
		"need_help":[
			{"text":"Преимущество на их стороне!"},
			{"text":"Они вооружены, Мастер!"},
			{"text":"Тебе меня не взять!"},
		],
		"pursuing":[
			{"text":"Там! Сердце открыто!"},
			{"text":"Удержи его - остальное я сделаю!"},
			{"text":"Слабыми займусь я."},
		],
		"running":[
			{"text":"Я больше долго этого не выдержу..."},
			{"text":"Я был не готов."},
		],
		"hull_90":[
			{"text":"Похоже, я был с ним слишком мягок."},
			{"text":"Это лишь поверхностная рана!"},
			{"text":"Хмф! Пустяки!"},
		],
		"hull_50":[
			{"text":"Я еще могу сражаться..."},
			{"text":"Этим меня не сломить!"},
		],
		"hull_30":[
			{"text":"Я был неосторожен..."},
			{"text":"Как жалко..."},
		],
		"overload":[
			{"text":"Нет! Преимущество у них!"},
			{"text":"Это опасный противник!"},
			{"text":"После этого... начнется самое интересное."},
		],
		"death":[
			{"text":"Я оплошал..."},
			{"text":"Какая оплошность..."},
			{"text":"Мой..."},
		],
		"victory":[
			{"text":"Мы никак не могли проиграть этому."},
			{"text":"Если позволишь, это была славная схватка."},
			{"text":"Наша сила принесла нам победу."},

			{"text":"Это даже разминкой не назвать!"},
		],
		"victory_boss":[
			{"text":"Этим нас не сломить!"},			
		]
	}
