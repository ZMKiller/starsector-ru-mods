	"categoryTags":["dawnofwar", "game", "othermedia"],
	
	"lines":{
		"start":[
			{"text":"Ступай тихо и держи большую пушку."},
			{"text":"Они пришли за нашей кровью, но утонут в своей!"},
			{"text":"Тот, кто стоит со мной, мой брат."},
			{"text":"Сегодня враг познает страх."},
			{"text":"Берегитесь ксеноса, мутанта и еретика."},
			{"text":"Этот день станет славным для Империума."},
		],
		"start_boss":[
			{"text":"Братья, великий враг приближается!"},
			{"text":"Не страшитесь его размеров!"},
			{"text":"Не бойтесь размеров врага!"},
		],
		"retreat":[
			{"text":"Я нужен в другом месте."},
			{"text":"Люди, мы должны отступить!"},
		],
		"out_of_missiles":[
		],
		"engaged":[
			{"text":"По моему приказу, в атаку!"},
			{"text":"Я не боюсь зла, ибо сам воплощенный страх!"},
			{"text":"В моей ярости они познают имя Императора!"},
			{"text":"Пленных не брать!"},
		],
		"need_help":[
			{"text":"Мы не познаем страха!"},
			{"text":"Братья, цельтесь верно!"},
			{"text":"Я не подведу!"},
		],
		"pursuing":[
			{"text":"Следуйте за мной."},
			{"text":"Вера и долг."},
			{"text":"Ко мне, братья!"},
			{"text":"Ведите меня на передовую!"},
			{"text":"За мной в бой!"},
		],
		"running":[
			{"text":"Отходим и перегруппировываемся!"},
			{"text":"Начать тактическое отступление!"},
		],
		"hull_90":[
			{"text":"Моя вера - мой щит!"},
			{"text":"Я не познаю страха."},
		],
		"hull_50":[
			{"text":"Ни шагу назад! Никакой капитуляции!"},
			{"text":"Моя меткость не дрогнет!"},
			{"text":"Император, защити нас!"},
		],
		"hull_30":[
			{"text":"До последнего бойца и последнего патрона!"},
			{"text":"Я не умру в этот день!"},
		],
		"overload":[
			{"text":"Вы не дрогнете!"},
			{"text":"Я не подведу!"},
		],
		"death":[
			{"text":"Прости меня, Император... я подвел тебя..."},
			{"text":"Нет! Мы не можем... проиграть..."},
			{"text":"Моя воля сломлена..."},
		],
		"victory":[
			{"text":"Пока враги Императора еще дышат, мира быть не может."},
			{"text":"Слава Императору."},
		],
		"victory_boss":[
			
		]
	}
