		"hull_30":[
			{"text":"Всем приготовиться покинуть корабль!"},
			{"text":"Падает давление охлаждения реактора!"},
			{"text":"Переборки складываются, долго я не протяну!"},
		],
		"overload":[
			{"text":"Системы перегружены!"},
			{"text":"Энергосеть не справляется!"},
			{"text":"Флюкс-конденсаторы перегружены!"},
		],
		"death":[
			{"text":"Я погибаю, чтобы вы жили."},
			{"text":"Почетная смерть."},
			{"text":"Корабль нестабилен, уходите от нас!"},
		],
		"victory":[
			{"text":"Мы показали им, что такое превосходство корабля."},
			{"text":"Мир через превосходящую огневую мощь."},
			{"text":"Стреляли чертовски метко, ребята."},
			{"text":"Бой выигран, но не забудем павших."},
