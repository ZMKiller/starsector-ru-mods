		"out_of_missiles":[
			{"text":"Ракетные установки израсходовали боекомплект."},
			{"text":"Мы израсходовали весь расходуемый боезапас."},
			{"text":"Ракеты закончились."},
			{"text":"Ракетные пилоны пусты."},
		],
		"engaged":[
			{"text":"Плотность огня высокая."},
			{"text":"Пытаюсь занять выгодную позицию для маневренного боя."},
			{"text":"Встречаем ожесточенное сопротивление."},
			{"text":"Пора заканчивать этот бой."},
		],
		"need_help":[
			{"text":"Ситуация плохая, запрашиваю поддержку."},
			{"text":"Без подкрепления я не вытяну."},
			{"text":"Исход миссии выглядит... неблагоприятно."},
		],
		"pursuing":[
			{"text":"Огонь на поражение."},
			{"text":"Рулевой, полный ход."},
			{"text":"Берем в вилку и огонь на поражение."},
			{"text":"Стрелять на уничтожение."},
		],
		"running":[
			{"text":"Начинаю тактическое отступление."},
			{"text":"Мы слишком далеко выдвинулись."},
			{"text":"Отходим, нужно перестроить боевой порядок."},
			{"text":"Позиция неустойчива."},
		],
		"hull_90":[
			{"text":"Получены легкие повреждения."},
			{"text":"Команде борьбы за живучесть приготовиться, бой только начался."},
			{"text":"Бронеплиты пробиты, но внутренние отсеки пока держатся."},
		],
		"hull_50":[
			{"text":"Машинное отделение докладывает о пробоинах корпуса!"},
			{"text":"Устранить утечку охлаждения реактора!"},
			{"text":"Переборки разрывает!"},
