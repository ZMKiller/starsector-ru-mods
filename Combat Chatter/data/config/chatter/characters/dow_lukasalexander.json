	"lines":{
		"start":[
			{"text":"Так, бойцы! Пора начинать войну!"},
			{"text":"Готов служить."},
			{"text":"Для меня это честь."},
			{"text":"Повиновение без колебаний."},
		],
		"start_boss":[
			{"text":"Я сокрушу эту мерзость!"},
			{"text":"Встретьтесь со мной, твари!"},
		],
		"retreat":[
			{"text":"Назад! Назад!"},
			{"text":"Уходим."},
		],
		"out_of_missiles":[
		],
		"engaged":[
			{"text":"Уничтожьте их сейчас!"},
			{"text":"Не щадите никого в своей ярости!"},
			{"text":"В гущу боя! В атаку!"},
		],
		"need_help":[
			{"text":"Пусть атакуют. Я вырву их сердца."},
			{"text":"По нам ведут огонь!"},
			{"text":"Держите позиции!"},
		],
		"pursuing":[
			{"text":"Там лежит победа."},
			{"text":"За мной, бойцы! В атаку!"},
			{"text":"Враг у нас на прицеле."},
			{"text":"Они не уйдут из моего прицела."},
		],
		"running":[
			{"text":"Отступаем и перегруппировываемся!"},
		],
		"hull_90":[
			{"text":"Убейте их на месте!"},
			{"text":"Отбросьте их! Пощады не давать!"},
		],
		"hull_50":[
			{"text":"Вы не испугаетесь! Вы не дрогнете! Вы не отдадите врагу ни шага!"},
			{"text":"Истинный слуга никогда не поддается сомнениям."},
		],
		"hull_30":[
			{"text":"Я не приму это поражение!"},
		],
		"overload":[
			{"text":"Что это за ересь?"},
		],
		"death":[
			{"text":"Лишь смерть завершает долг."},
			
		],
		"victory":[
			{"text":"Длань Императора направляет всех."},
