	"lines":{
		"start":[
			{"text":"Пора в бой, парни."},
			{"text":"К орудиям!"},
			{"text":"Плывем к богатству! Вперед!"},
			{"text":"Добыча ждет, мои бравые!"},
			{"text":"Пусть боятся капитана Таннена!"},
