		"start_boss":[
			{"text":"Арр, вот он, могучий Левиафан!"},
			{"text":"Кракен приближается!"},
			{"text":"Еще одна голова для моей каюты!"},
		],		
		"retreat":[
			{"text":"Руль на разворот и уходим, парни!"},
			{"text":"Пора уходить, пока можем!"},
			{"text":"Честь - это выжить и биться в другой день!"},
		],
		"out_of_missiles":[
			{"text":"Торпеды вышли, все до одной."},
			{"text":"Тяжелых боеприпасов больше нет, парни!"},
		],
		"engaged":[
			{"text":"Ко мне, морские черти!"},
			{"text":"Орудия, огонь!"},
			{"text":"Вижу белки их глаз."},
			{"text":"Всем на палубу!"},
			{"text":"Мечи наголо, пушки к бою!"},
		],
		"need_help":[
			{"text":"Ко мне, парни! Нас потопят, если не продавим!"},
			{"text":"У меня проблемы!"},
			{"text":"Выжми из нее все, что можно!"},
		],
		"pursuing":[
			{"text":"В погоню, морские волки!"},
			{"text":"Не дайте им уйти, парни!"},
			{"text":"Вы мои, ублюдки!"},
		],
		"running":[
			{"text":"Капитана Таннена вам живым не взять!"},
			{"text":"Отходим, не дайте им нас догнать!"},
		],
		"hull_90":[
			{"text":"Нас зацепило!"},
			{"text":"Подумаешь, царапина."},
		],
		"hull_50":[
			{"text":"Держитесь, парни! Она еще держится!"},
			{"text":"Мы набираем воду!"},
		],
		"hull_30":[
			{"text":"Ох, это уже совсем нехорошо!"},
			{"text":"Мы почти ко дну!"},
			{"text":"Не сдавайтесь, парни!"},
			{"text":"Капитан Таннен не умрет!"},
		],
		"overload":[
			{"text":"Кто из вас, болваны, перегрузил конденсаторы?!"},
			{"text":"Запускайте мой корабль, или кто-то пойдет по доске!"},
		],
		"death":[
			{"text":"Хех. Неплохо."},
			{"text":"Это еще не последняя наша встреча!"},
			{"text":"Пора приветствовать перевозчика душ."},
		],
		"victory":[
			{"text":"Мы взяли этот день, парни!"},
			{"text":"Пора делить добычу, мужики!"},
			{"text":"Золото и слава!"},
			{"text":"Капитан Таннен снова побеждает!"},
