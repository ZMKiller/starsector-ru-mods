{
	"id":"dpl_doom_flamer",  # this id must match what's in the spreadsheet
	"specClass":"projectile",
	"type":"ENERGY",
	"mountTypeOverride":"HYBRID",
	"size":"SMALL",
	"everyFrameEffect":"data.scripts.weapons.dpl_doom_flamerEffect",
	"turretSprite":"graphics/weapons/dpl_doom_flamer_turret_base.png",
	"turretGlowSprite":"graphics/weapons/dpl_doom_flamer_turret_glow.png",
	"hardpointSprite":"graphics/weapons/dpl_doom_flamer_hardpoint_base.png",
	"hardpointGlowSprite":"graphics/weapons/dpl_doom_flamer_hardpoint_glow.png",
	"glowColor":[255,200,45,255],
	"turretOffsets":[15, 0],
	"turretAngleOffsets":[0],
	"hardpointOffsets":[15, 0],
	"hardpointAngleOffsets":[0],
	"barrelMode":"ALTERNATING", # or LINKED.  whether barrels fire at the same time or alternate.
	"unaffectedByProjectileSpeedBonuses":true,
	#"animationType":"GLOW",
	#"animationType":"GLOW_AND_FLASH",
	"animationType":"GLOW",
	"muzzleFlashSpec":{"length":30.0,   # only used if animationType = MUZZLE_FLASH or GLOW_AND_FLASH
					   "spread":5.0,
					   "particleSizeMin":15.0,
					   "particleSizeRange":20.0,
					   "particleDuration":0.12,
					   "particleCount":10,
					   "particleColor":[255,200,45,255]},
	"autocharge":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held
	"projectileSpecId":"dpl_doom_flamer_shot",  # projectile that will be fired
	"noImpactSounds":true,
}