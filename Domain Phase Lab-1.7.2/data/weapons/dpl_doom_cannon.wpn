{
	"id":"dpl_doom_cannon",  # this id must match what's in the spreadsheet
	"specClass":"projectile",
	"type":"ENERGY",
	"size":"LARGE",
	"turretSprite":"graphics/weapons/dpl_doom_cannon_turret_base.png",
	"turretGlowSprite":"graphics/weapons/dpl_doom_cannon_turret_glow.png",
	"hardpointSprite":"graphics/weapons/dpl_doom_cannon_hardpoint_base.png",
