					   "particleDuration":0.15,
					   "particleCount":30,
					   "particleColor":[255,100,50,255]},
	"interruptibleBurst":false,
	"autocharge":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held
	"projectileSpecId":"dpl_doom_cannon_shot",  # projectile that will be fired
